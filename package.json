{
  "name": "pi-extensions",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Personal extensions for the Pi coding agent",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test",
    "check:ci": "npm run check && npm run check:plans && npm run check:portability",
    "check:plans": "bash .github/scripts/check-active-plans.sh",
    "check:portability": "python3 .github/scripts/check-portable-paths.py",
    "test": "node --test extensions/*/*.test.ts examples/*/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/built-in-tool-renderer/index.ts",
      "./extensions/clear-reload/index.ts",
      "./extensions/enable-extra-tools/index.ts",
      "./extensions/exit/index.ts",
      "./extensions/focus-aware-cursor/index.ts",
      "./extensions/jj-status/index.ts",
      "./extensions/local-agent-context/index.ts",
      "./extensions/mcp/index.ts",
      "./extensions/tool-permissions/index.ts",
      "./extensions/subagent/index.ts"
    ]
  },
  "dependencies": {
    "@decimalturn/toml-patch": "^2.1.0",
    "ignore": "^7.0.6",
    "smol-toml": "^1.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
