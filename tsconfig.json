{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "paths": {
      "pi-extensions/*": ["./*"]
    }
  },
  "include": ["extensions/**/*.ts", "examples/**/*.ts"]
}
